{
	"name": "dburguercli",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ARQUIVOS",
						"type": "DatasetReference"
					},
					"name": "dbcli"
				},
				{
					"dataset": {
						"referenceName": "ARQUIVOS",
						"type": "DatasetReference"
					},
					"name": "dbclifisica"
				},
				{
					"dataset": {
						"referenceName": "ARQUIVOS",
						"type": "DatasetReference"
					},
					"name": "dblogradouro"
				},
				{
					"dataset": {
						"referenceName": "ARQUIVOS",
						"type": "DatasetReference"
					},
					"name": "dbendcli"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ARQUIVOS",
						"type": "DatasetReference"
					},
					"name": "tabeladburguer"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     pNomeArquivo as string ('teste.csv')",
				"}",
				"source(output(",
				"          NR_CLIENTE as short,",
				"          NM_CLIENTE as string,",
				"          QT_ESTRELAS as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dbcli",
				"source(output(",
				"          NR_CLIENTE as short,",
				"          FL_SEXO as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dbclifisica",
				"source(output(",
				"          CD_LOGRADOURO as short,",
				"          CD_BAIRRO as short,",
				"          NM_LOGRADOURO as string,",
				"          NR_CEP as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dblogradouro",
				"source(output(",
				"          NR_CLIENTE as short,",
				"          CD_LOGRADOURO_CLI as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dbendcli",
				"dbcli, dbclifisica join(dbcli@NR_CLIENTE == dbclifisica@NR_CLIENTE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, dbendcli join(dbcli@NR_CLIENTE == dbendcli@NR_CLIENTE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, dblogradouro join(CD_LOGRADOURO_CLI == CD_LOGRADOURO,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> tabeladburguer"
			]
		}
	}
}